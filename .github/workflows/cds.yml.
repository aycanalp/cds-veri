name: Turkiye CDS toplayici

on:
  workflow_dispatch:
  schedule:
    # 09:41 ve 16:41 Istanbul (UTC+3) = 06:41 ve 13:41 UTC, hafta ici
    - cron: "41 6,13 * * 1-5"

permissions:
  contents: write

jobs:
  topla:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Kutuphaneler
        run: pip install requests curl_cffi

      - name: CDS oku
        run: python collect.py

      - name: Kaydet
        if: always()
        run: |
          git config user.name "CDS toplayici"
          git config user.email "actions@users.noreply.github.com"
          git add data/
          git diff --cached --quiet || (git commit -m "CDS verisi $(date -u +%Y-%m-%d_%H:%M)" && git push)
